{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Udp": {
    "Enabled": true,
    "Port": 514
  },
  "Tcp": {
    "Enabled": false,
    "Port": 1234
  },
  "RabbitMq": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "logs.exchange",
    "QueueName": "logs.queue",
    "RoutingKey": "log.#"
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "Topic": "logs",
    "GroupId": "logous-ingestion"
  },
  "DatabaseSettings": {
    "DefaultConnection": "Server=localhost;Database=LogousDB;User Id=sa;Password=YourStrongPassword;TrustServerCertificate=true;"
  }
}
